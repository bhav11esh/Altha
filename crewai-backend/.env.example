# Environment Configuration Example
# Copy this to .env and fill in actual values

# Logging
LOG_LEVEL=info

# Server
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# Database (for production)
DATABASE_URL=postgresql://user:password@localhost/medical_ai

# External APIs (mock for now)
UPTODATE_API_KEY=your_api_key
CIMS_API_KEY=your_api_key
PUBMED_API_KEY=your_api_key

# Authentication (if needed)
API_AUTH_KEY=your_secret_key

# Monitoring
SENTRY_DSN=optional_sentry_monitoring_url
